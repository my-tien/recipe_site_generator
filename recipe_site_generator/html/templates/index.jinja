                       /                                                                                                                                                        /#######  /#  
                      /                                                                                                                                                        /      ###/    
    </pre>

    <p>Welcome to the bakery!</p>

    <p>The smell of freshly baked bread hangs in the air and the walls are lined with bread and pastries.</p>

    <h1>Recipes</h1>

    <p>Between breadcrumbs and oven mittens lies an open book full of German recipes:</p>

    {% for folder in folders %}
        <h2>{{ folder.name }}</h2>
        {% if folder.description %}
        <p>{{ folder.description }}</p>
        {% endif %}
        <ul>
        {% for recipe in folder.recipes %}
        <li><a href='{{ recipe.link }}'></a>{{recipe.title}} {{recipe.date}}</li>
        {% endfor %}
        </ul>
    {% endif %}
</div>
</body>
</html>