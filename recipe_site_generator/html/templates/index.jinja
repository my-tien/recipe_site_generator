<!doctype html>
<html lang='de-DE'>

<head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width' />
    <title>The German bakery</title>

    <style>
        * {
            margin: 0;
            padding: 0;
        }

        body {
            color: #242424;
            font-family: sans-serif;
            line-height: 1.6;
            padding: 2rem 4rem;
        }

        .asciiart {
            color: #8f5902;
            font-weight: 600;
            line-height: 1em;
            
        }
        .container {
            max-width: 99ch;
        }

        .container > img {
            display: block;
            max-width: 100%;
        }

        .container > * + * {
            margin-top: 1rem;
        }

        h1, h2, h3, h4, h5, h6 {
            color: #8f5902;
            margin-top: 2rem;
        }
        
        table {
            border-collapse: collapse;
        }
        table td:first-of-type {
            font-weight: bold;
            text-align: right;
        }

        table td:last-of-type {
            border-left: 1px solid #8f5902;
            padding-left: 1rem;
        }

        table td {
            padding: 0.5rem 1rem;
        }

        table tr:nth-of-type(2n) {
            background-color: #e9b96e;
        }

        ul {
            list-style: square;
            margin-left: 36px;
        }
        ul > li + li {
            margin-top: 0.5rem;
        }

        hr {
            background-color: #e9b96e;
            border: 0;
            height: 2px;
            margin-top: 2rem;
        }

        a {
            color: #8f5902;
            text-decoration: none;
            border-bottom: 2px dashed #e9b96e;
        }

        a:hover {
            border-bottom-color: #8f5902;
        }

    </style>
</head>

<body>
<div class="container">
    <pre class="asciiart">
